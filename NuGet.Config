<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Solo la sorgente pubblica. Eventuali proxy vanno impostati con le variabili d'ambiente
       HTTP_PROXY/HTTPS_PROXY, non qui: un proxy scritto nel file rompe la build altrove (CI, Docker). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
