# =============================================================================
# CardExchange – Environment Variables
# Copy this file to .env and fill in production values
# =============================================================================

# --- Database (SQL Server) ---------------------------------------------------
# SA password for the SQL Server container
SA_PASSWORD=YourStrongPassword123!

# --- JWT Authentication ------------------------------------------------------
# Secret key for signing JWT tokens (min 32 bytes, use a random string)
JWT_SECRET_KEY=YourSuperSecretKeyAtLeast32BytesLong123!

# --- CORS --------------------------------------------------------------------
# Frontend origin allowed by the API (no trailing slash)
CORS_ORIGIN=http://localhost:5173

# --- Email (SMTP) -------------------------------------------------------------
# Senza SMTP_HOST le email (verifica account, reset password) NON vengono inviate,
# vengono solo scritte nel log. Qualsiasi provider SMTP va bene (Brevo, Mailgun, SES...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# true = STARTTLS (587), false = SSL implicito (465)
SMTP_USE_STARTTLS=true
EMAIL_FROM_ADDRESS=no-reply@example.com
# URL pubblico del frontend, usato nei link delle email (senza slash finale)
FRONTEND_BASE_URL=http://localhost:5173

# --- Limiti del piano gratuito ----------------------------------------------
# Voci massime in collezione per gli utenti gratuiti (stessa carta, condizione,
# lingua e finitura = 1 voce). Vuoto = nessun limite (impostazione attuale).
# Esempio futuro: 1000 per i privati, con un piano "Negozio" a pagamento senza limite.
PLAN_FREE_MAX_CARDS=

# --- Notifiche push (PWA / Web Push) ----------------------------------------
# Senza chiavi le notifiche push sono disattivate (in sviluppo ne viene generata
# una coppia temporanea a ogni avvio). Per generarle:
#   dotnet run --project CardExchange.API -- --generate-vapid-keys
# Non cambiarle dopo il lancio: i dispositivi già registrati smetterebbero di ricevere notifiche.
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:supporto@example.com

# --- Lavori pianificati ---------------------------------------------------------
# Manutenzione notturna (prezzi, storico, scadenze, allarmi) e riepilogo settimanale
JOBS_DAILY_RUN_AT_UTC=02:30
JOBS_WEEKLY_DIGEST_ENABLED=true

# --- ASP.NET Core -------------------------------------------------------------
# Environment: Development | Staging | Production
# ASPNETCORE_ENVIRONMENT=Production
